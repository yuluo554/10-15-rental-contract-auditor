# Python 标准模板

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
*.spec
# 例外：打包 spec 是我们的源码，必须入仓（`*.spec` 通配会把它吞掉）
!tools/rca.spec
wheels/
pip-wheel-metadata/

# Environments
.env
.venv
env/
venv/

# Private / local data
_private/
data/**/_private/

# 验证期草稿产物（放仓库树外或此目录，绝不入仓）
_scratch/
_backups/
# 迭代批次的诊断/路线/执行记录：含本机绝对路径，入仓必被审计器判 HARD
update/

# Logs / caches
*.log
.pytest_cache/
.mypy_cache/
.ruff_cache/

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
